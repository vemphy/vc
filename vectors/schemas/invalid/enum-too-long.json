{
  "rule": "an enum has at most 50 values",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "x-vemphy": {
      "name": "StaffIdCard",
      "displayName": {
        "en": "Staff ID card"
      }
    },
    "properties": {
      "holderName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\t\\n\\r ]([^\\t\\n\\r]*[^\\t\\n\\r ])?$",
        "x-vemphy": {
          "label": {
            "en": "Name"
          },
          "disclosable": true,
          "pii": true,
          "order": 1
        }
      },
      "staffNumber": {
        "type": "string",
        "maxLength": 12,
        "pattern": "^[A-Z]{1,3}-\\d{3,8}$",
        "x-vemphy": {
          "label": {
            "en": "Staff number"
          },
          "disclosable": false,
          "pii": true,
          "order": 2
        }
      },
      "department": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[^\\t\\n\\r ]([^\\t\\n\\r]*[^\\t\\n\\r ])?$",
        "x-vemphy": {
          "label": {
            "en": "Department"
          },
          "disclosable": true,
          "pii": false,
          "order": 3
        }
      },
      "grade": {
        "type": "string",
        "enum": [
          "g0",
          "g1",
          "g2",
          "g3",
          "g4",
          "g5",
          "g6",
          "g7",
          "g8",
          "g9",
          "g10",
          "g11",
          "g12",
          "g13",
          "g14",
          "g15",
          "g16",
          "g17",
          "g18",
          "g19",
          "g20",
          "g21",
          "g22",
          "g23",
          "g24",
          "g25",
          "g26",
          "g27",
          "g28",
          "g29",
          "g30",
          "g31",
          "g32",
          "g33",
          "g34",
          "g35",
          "g36",
          "g37",
          "g38",
          "g39",
          "g40",
          "g41",
          "g42",
          "g43",
          "g44",
          "g45",
          "g46",
          "g47",
          "g48",
          "g49",
          "g50"
        ],
        "x-vemphy": {
          "label": {
            "en": "Grade"
          },
          "disclosable": true,
          "pii": false,
          "order": 4
        }
      },
      "issuedOn": {
        "type": "string",
        "format": "date",
        "x-vemphy": {
          "label": {
            "en": "Issued on"
          },
          "disclosable": true,
          "pii": false,
          "order": 5
        }
      }
    },
    "required": [
      "holderName",
      "staffNumber",
      "grade",
      "issuedOn"
    ]
  }
}
